# --- Build time (put these in a local .env before `npm run package`; baked into the static build) ---

# Public site URL used for canonical links, sitemap and Open Graph.
# On Azure, WEBSITE_HOSTNAME is used automatically if this is unset.
SITE_URL=https://www.humancode.org.uk

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=

# --- Run time (set as App Service application settings; read by server.js) ---

# Booking form delivery via Resend. Emails go to every address in FORM_TO.
RESEND_API_KEY=
FORM_TO=bookings@humancode.org.uk,hello@humancode.org.uk
FORM_FROM=Human Code <bookings@humancode.org.uk>
