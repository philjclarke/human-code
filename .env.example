# Public site URL (used for canonical links, sitemap and Open Graph). Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL automatically; set this to override.
SITE_URL=https://www.humancode.co.uk

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=

# Booking form delivery (Resend). Emails are sent to every address in BOOKING_TO.
RESEND_API_KEY=
BOOKING_TO=bookings@humancode.co.uk,hello@humancode.co.uk
BOOKING_FROM=Human Code <bookings@humancode.co.uk>
