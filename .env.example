# --- Build time (set as GitHub Actions variables; baked into the static build) ---

# Public site URL used for canonical links, sitemap and Open Graph.
# On Azure, WEBSITE_HOSTNAME is used automatically if this is unset.
SITE_URL=https://www.humancode.co.uk

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
PUBLIC_GA_MEASUREMENT_ID=

# --- Run time (set as App Service application settings; read by server.js) ---

# Booking form delivery via Resend. Emails go to every address in BOOKING_TO.
RESEND_API_KEY=
BOOKING_TO=bookings@humancode.co.uk,hello@humancode.co.uk
BOOKING_FROM=Human Code <bookings@humancode.co.uk>
