---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { categoryLabel } from '@/lib/knowledge';
interface Props { article: CollectionEntry<'knowledge'>; featured?: boolean }
const { article, featured = false } = Astro.props;
const { title, summary, category, readingTime } = article.data;
---
<a href={`/knowledge/${article.id}/`} class:list={['card group flex flex-col no-underline', featured && 'sm:col-span-2 lg:col-span-1']}>
  <p class="eyebrow">{categoryLabel(category)}</p>
  <h3 class="mt-3 font-display text-2xl font-semibold leading-tight">{title}</h3>
  <p class="mt-3 text-[0.97rem] text-ink-soft">{summary}</p>
  <span class="mt-auto flex items-center justify-between pt-8 text-sm text-mute">
    <span>{readingTime ?? 4} min read</span>
    <span class="arrow-link"><span class="sr-only">Read</span><Icon name="arrow" class="size-3.5" /></span>
  </span>
</a>
