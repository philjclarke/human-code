---
import Base from '@/layouts/Base.astro';
import Band from '@/components/Band.astro';
import Button from '@/components/Button.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaBand from '@/components/CtaBand.astro';
import Photo from '@/components/Photo.astro';
import { site, pricing } from '@/data/site';

const problems = [
  {
    title: 'Build more confident managers',
    recognise: 'Managers who avoid the conversation, or have it badly, because they are not sure what they are allowed to say.',
    change: 'Managers leave knowing what to do, what to say and where the boundaries are. Confident, not cautious.',
  },
  {
    title: 'Retain good people',
    recognise: 'Capable people who leave for reasons that seem small from the outside, and were probably avoidable.',
    change: 'Small changes to how work is set up, communicated and reviewed that keep good people doing good work.',
  },
  {
    title: 'Improve performance',
    recognise: 'Someone who is brilliant at one part of the job and consistently struggles with another.',
    change: 'Clearer expectations, better matched support and higher standards. Understanding does not mean lowering the bar.',
  },
  {
    title: 'Use people’s strengths better',
    recognise: 'Strengths that only show up by accident, because nobody asked.',
    change: 'A simple habit of asking rather than assuming, so strengths are found and used on purpose.',
  },
  {
    title: 'Staff new projects more intelligently',
    recognise: 'Teams assembled by availability, then surprised when the mix does not work.',
    change: 'Managers who think about how people work, not just what they know, when they allocate work.',
  },
  {
    title: 'Handle difficult situations earlier',
    recognise: 'A problem that everybody could see coming and nobody addressed until it became formal.',
    change: 'Earlier, calmer conversations. Fewer situations that escalate to HR, grievance or exit.',
  },
  {
    title: 'Improve working relationships',
    recognise: 'Friction that comes down to two people communicating in different ways and each assuming the worst.',
    change: 'A shared language across the organisation for how people work and communicate differently.',
  },
  {
    title: 'Reduce avoidable management and legal risk',
    recognise: 'Managers unsure of their responsibilities around adjustments, disclosure and confidentiality.',
    change: 'Basic legal awareness built into good management practice, and clarity on when to involve HR, occupational health or legal advice.',
  },
];
---
<Base title="For leaders" description="Better management for different brains: more confident managers, better retention, better performance and smarter use of your people’s strengths.">
  <Band tight>
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <SectionHead
          as="h1"
          eyebrow="For CEOs, MDs, headteachers and people directors"
          title="Get more from the people you already have"
          lede="You are not short of capable people. You are short of managers who know how to get the best from all of them. Human Code fixes that, across the whole organisation, in five hours."
        />
      </div>
      <div class="reveal lg:col-span-4 lg:justify-self-end">
        <Button href={site.cta.href} cta dot size="lg">{site.cta.short}</Button>
      </div>
    </div>
  </Band>

  <Band tight>
    <Photo src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=2000&q=70" alt="A leader talking with colleagues in a meeting room" mono ratio="21 / 9" />
  </Band>

  <Band>
    <SectionHead
      eyebrow="What changes"
      title="Problems you will recognise. Changes you will notice"
      lede="Human Code is organised around the situations leaders actually deal with, not around conditions or labels."
    />
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {problems.map((p, i) => (
        <div class="card reveal" style={`transition-delay:${(i % 2) * 80}ms`}>
          <h2 class="font-display text-2xl font-semibold leading-tight sm:text-[1.7rem]">{p.title}</h2>
          <dl class="mt-6 space-y-5">
            <div>
              <dt class="eyebrow">You might recognise</dt>
              <dd class="mt-1.5 text-ink-soft">{p.recognise}</dd>
            </div>
            <div>
              <dt class="eyebrow">What changes</dt>
              <dd class="mt-1.5">{p.change}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
  </Band>

  <Band tone="dark">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-6">
        <SectionHead
          eyebrow="Standards"
          title="Better understanding does not mean lower standards"
          lede="It means better management. Managers should leave Human Code more able to manage performance, not frightened to."
        />
      </div>
      <div class="reveal lg:col-span-5 lg:col-start-8" style="transition-delay:120ms">
        <blockquote class="font-display text-display-sm font-medium leading-snug">
          “See the need. Respond to the need. Don’t diagnose the reason.”
        </blockquote>
        <p class="mt-6 text-paper/70">The Human Code principle. Nobody is diagnosed. Nobody is asked to disclose anything. Everybody is managed better.</p>
        <div class="mt-8"><ArrowLink href="/what-to-expect/">What your staff will be told</ArrowLink></div>
      </div>
    </div>
  </Band>

  <Band>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SectionHead
          eyebrow="The commitment"
          title="Five hours. One price. No dependency"
          lede={`The whole programme, leader to all staff, is ${pricing.online.display} live online or ${pricing.faceToFace.display} face-to-face, plus VAT, for an organisation of up to 100 people. No subscription, no follow-on consultancy.`}
        />
        <div class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
          <ArrowLink href="/pricing/">See pricing</ArrowLink>
          <ArrowLink href="/how-it-works/">How it works</ArrowLink>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-3 lg:col-span-7">
        {[
          ['1 hr', 'You', 'Understand and lead'],
          ['2 hrs', 'Your managers', 'Know what to do'],
          ['2 hrs', 'Everyone', 'Work better together'],
        ].map(([t, who, what], i) => (
          <div class="card reveal" style={`transition-delay:${i * 80}ms`}>
            <p class="font-display text-display-md font-semibold text-peach-deep">{t}</p>
            <p class="eyebrow mt-4">{who}</p>
            <p class="mt-1 font-display text-xl font-semibold">{what}</p>
          </div>
        ))}
      </div>
    </div>
  </Band>

  <CtaBand tone="dark" title="Book your free 60-minute CEO briefing" body="Twenty minutes of briefing, thirty minutes applied to your organisation, ten minutes to decide. Useful either way." />
</Base>
