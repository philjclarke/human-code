---
import Base from '@/layouts/Base.astro';
import Band from '@/components/Band.astro';
import ArrowLink from '@/components/ArrowLink.astro';
import SectionHead from '@/components/SectionHead.astro';
import CtaBand from '@/components/CtaBand.astro';
import Photo from '@/components/Photo.astro';
import { principles } from '@/data/site';

// TODO(client): replace placeholder writers with real names, photographs, biographies and qualifications.
const writers = [
  {
    name: 'Writer name',
    role: 'Lead author',
    bio: 'Placeholder. An experienced teacher and coach with a background in leadership development and workplace training. Two or three sentences on career, specialism and why they wrote Human Code.',
    quals: ['Qualification placeholder', 'Qualification placeholder', 'Qualification placeholder'],
    photo: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=800&q=70',
  },
  {
    name: 'Writer name',
    role: 'Co-author',
    bio: 'Placeholder. An experienced coach with a background in organisational development and adult education. Two or three sentences on career, specialism and contribution to the programme.',
    quals: ['Qualification placeholder', 'Qualification placeholder'],
    photo: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=800&q=70',
  },
];

const evidence = [
  ['Evidence-informed', 'Human Code draws on published research into neurodiversity at work, management practice and adult learning. Every Knowledge Hub article cites its sources.'],
  ['Reviewed on a cycle', 'Content carries a named author, a review date and a reviewer. It is revised when the evidence or the law changes.'],
  ['Measured in practice', 'Pilot programmes are documented with before-and-after measures of manager confidence, behaviour and practice. Case studies follow as they are completed.'],
];

const qa = [
  ['Experienced teachers and coaches', 'Every trainer is an experienced teacher or coach first. Not a clinician, not a psychologist, and not presented as one.'],
  ['One consistent programme', 'Trainers deliver the same Human Code programme, with the same materials and the same principles, wherever it is delivered.'],
  ['Trained and approved', 'Trainers complete Human Code training and are approved before they deliver. Delivery is reviewed and feedback is collected from every session.'],
];
---
<Base title="About Human Code" description="Why Human Code exists, who wrote it, the evidence behind it, why teachers deliver it and the principles it runs on.">
  <Band tight>
    <SectionHead
      as="h1"
      eyebrow="About Human Code"
      title="Why Human Code exists"
      lede="Most organisations have people who are clearly capable and somehow difficult to manage. Most managers have never been shown what to do about it. Human Code closes that gap with practical training that the whole organisation can use."
      class="max-w-4xl"
    />
  </Band>

  <Band tight>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="prose-hc lg:col-span-7">
        <p>
          Neurodiversity training has usually been sold as awareness. Awareness is fine, but it does not tell a manager what to do on Monday morning when a capable person has missed a deadline again, or a meeting has gone badly for the third time, or someone brilliant has just handed in their notice.
        </p>
        <p>
          Human Code starts from the other end. It is a better-management product built around understanding different brains. Neurodiversity is the subject. Better management and better performance are the point.
        </p>
        <p>
          It is deliberately short, deliberately practical and deliberately whole-organisation. Leaders understand, managers act, teams work better together. Then we get out of the way, and you keep the materials.
        </p>
        <p>
          <!-- TODO(client): founding story, in the founders' words. -->
          <em>Placeholder: a short paragraph in the founders’ own words about where Human Code came from and what they want it to change.</em>
        </p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <Photo src="https://images.unsplash.com/photo-1515187029135-18ee286d815b?auto=format&fit=crop&w=1000&q=70" alt="People working together at a shared table" mono ratio="4 / 5" />
      </div>
    </div>
  </Band>

  <Band tone="dark">
    <SectionHead eyebrow="Who created the programme" title="Written by people who teach for a living" lede="Human Code was written by experienced teachers and coaches whose job is to make complicated things understandable." />
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {writers.map((w, i) => (
        <article class="card reveal grid gap-6 sm:grid-cols-12" style={`transition-delay:${i * 90}ms`}>
          <div class="sm:col-span-4">
            <Photo src={w.photo} alt={`Portrait of ${w.name}`} ratio="4 / 5" />
          </div>
          <div class="sm:col-span-8">
            <p class="eyebrow">{w.role}</p>
            <h3 class="mt-2 font-display text-2xl font-semibold">{w.name}</h3>
            <p class="mt-3 text-paper/75">{w.bio}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {w.quals.map((q) => <li class="rounded-full border border-line-dark px-3 py-1 text-xs font-medium text-paper/80">{q}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </Band>

  <Band>
    <SectionHead eyebrow="Evidence and research" title="Researched, referenced, reviewed" />
    <div class="mt-12 grid gap-x-8 gap-y-8 md:grid-cols-3">
      {evidence.map(([t, b], i) => (
        <div class="reveal border-t border-line pt-5" style={`transition-delay:${i * 80}ms`}>
          <h3 class="font-display text-2xl font-semibold">{t}</h3>
          <p class="mt-2 text-ink-soft">{b}</p>
        </div>
      ))}
    </div>
    <div class="mt-10"><ArrowLink href="/knowledge/">Browse the Knowledge Hub</ArrowLink></div>
  </Band>

  <Band tone="paper2">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <SectionHead eyebrow="Why teachers deliver Human Code" title="Teaching is the skill" lede="Explaining a complex subject clearly to a room of busy adults, and getting them to do something differently afterwards, is a teaching skill. So Human Code is delivered by teachers and coaches." />
        <div class="mt-8"><ArrowLink href="/trainers/">Meet the trainers</ArrowLink></div>
      </div>
      <div class="space-y-6 lg:col-span-6 lg:col-start-7">
        {qa.map(([t, b], i) => (
          <div class="reveal border-t border-line pt-5" style={`transition-delay:${i * 80}ms`}>
            <h3 class="font-display text-2xl font-semibold">{t}</h3>
            <p class="mt-2 text-ink-soft">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </Band>

  <Band>
    <SectionHead eyebrow="Human Code principles" title="Six things we won’t compromise on" />
    <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {principles.map((p, i) => (
        <li class="card reveal" style={`transition-delay:${(i % 3) * 70}ms`}>
          <span class="font-display text-display-md font-semibold leading-none text-peach">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-6 font-display text-2xl font-semibold leading-tight">{p.title}</h3>
          <p class="mt-3 text-ink-soft">{p.body}</p>
        </li>
      ))}
    </ol>
  </Band>

  <CtaBand />
</Base>
